<Project>

  <!--
    Aspire's AppHost SDK injects host-RID-specific packages (Aspire.Dashboard.Sdk.<rid> and
    Aspire.Hosting.Orchestration.<rid>) into the AppHost and its consumer, so one lock file cannot
    describe every host. These two projects therefore keep one lock file per RID: the default
    packages.lock.json is win-x64's, and every other host writes packages.<rid>.lock.json.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'AspireAppointments.AppHost' or '$(MSBuildProjectName)' == 'AspireAppointments.Tests'">
    <RaunRidLockProject>true</RaunRidLockProject>
    <NuGetLockFilePath Condition="'$(NETCoreSdkRuntimeIdentifier)' != 'win-x64'">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'packages.$(NETCoreSdkRuntimeIdentifier).lock.json'))</NuGetLockFilePath>
    <!-- The RIDs whose lock files are committed: what CI restores on, and what a maintainer develops on. -->
    <RaunLockedRuntimeIdentifiers Condition="'$(RaunLockedRuntimeIdentifiers)' == ''">win-x64;linux-x64</RaunLockedRuntimeIdentifiers>
    <!-- Exactly one project drives the refresh, so a restore spawns one nested restore per RID
         rather than one per project. -->
    <RaunRidLockRefreshRoot Condition="'$(MSBuildProjectName)' == 'AspireAppointments.AppHost'">true</RaunRidLockRefreshRoot>
    <RaunSolutionPath>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', 'Raun.slnx'))</RaunSolutionPath>
  </PropertyGroup>

  <!--
    What the refresh reads and what it writes, so MSBuild can skip it when nothing could have
    changed: anything that can move the resolved graph is an input, and the other RIDs' lock files
    are the outputs. A no-op build therefore pays nothing, and editing Directory.Packages.props or a
    project file makes the inputs newer and runs it.
  -->
  <ItemGroup Condition="'$(RaunRidLockRefreshRoot)' == 'true'">
    <_RaunRidLockInput Include="$(MSBuildThisFileDirectory)Directory.Packages.props" />
    <_RaunRidLockInput Include="$(MSBuildThisFileDirectory)Directory.Build.props" />
    <_RaunRidLockInput Include="$(MSBuildThisFileDirectory)Directory.Build.targets" />
    <_RaunRidLockInput Include="$(MSBuildThisFileDirectory)src\**\*.csproj" />
    <_RaunRidLockInput Include="$(MSBuildThisFileDirectory)samples\**\*.csproj" />
    <_RaunRidLockInput Include="$(MSBuildThisFileDirectory)test\**\*.csproj" />
  </ItemGroup>

  <!-- On win-x64 the other RID's files are the packages.<rid>.lock.json pair; everywhere else the
       one left behind is win-x64's, which is the plain packages.lock.json. -->
  <ItemGroup Condition="'$(RaunRidLockRefreshRoot)' == 'true' and '$(NETCoreSdkRuntimeIdentifier)' == 'win-x64'">
    <_RaunRidLockOutput Include="$(MSBuildThisFileDirectory)samples\AspireAppointments\AspireAppointments.AppHost\packages.linux-x64.lock.json" />
    <_RaunRidLockOutput Include="$(MSBuildThisFileDirectory)samples\AspireAppointments\AspireAppointments.Tests\packages.linux-x64.lock.json" />
  </ItemGroup>

  <ItemGroup Condition="'$(RaunRidLockRefreshRoot)' == 'true' and '$(NETCoreSdkRuntimeIdentifier)' != 'win-x64'">
    <_RaunRidLockOutput Include="$(MSBuildThisFileDirectory)samples\AspireAppointments\AspireAppointments.AppHost\packages.lock.json" />
    <_RaunRidLockOutput Include="$(MSBuildThisFileDirectory)samples\AspireAppointments\AspireAppointments.Tests\packages.lock.json" />
  </ItemGroup>

  <!--
    A lock-writing restore refreshes EVERY committed RID's lock file, not just the host's. Without
    this, regenerating on one platform leaves the other platform's file describing the old graph,
    and the mismatch only surfaces as a failed locked-mode restore on whichever machine did not run
    it — which is exactly how a dependency bump broke CI once already.

    Every restore that may rewrite a lock file does this, because Directory.Build.props turns
    RestoreForceEvaluate on outside locked mode: updating a package from Visual Studio or the CLI
    leaves ALL the lock files correct with no second command to remember. Locked mode is excluded
    there, so CI still fails on a stale lock rather than quietly rewriting it. The Inputs/Outputs
    above keep a no-op restore free. The inner restores set RaunSkipRidLockRefresh so they cannot
    recurse.

    Two hooks because restoring a solution never runs a project's own Restore target: it collects
    each project's restore graph instead (_GenerateRestoreGraphProjectEntry) and restores once at
    the top. A target runs at most once per project, so `dotnet restore Raun.slnx` and
    `dotnet restore <project>` each refresh the other RIDs exactly one time.
  -->
  <Target Name="RaunRefreshRidLockFiles"
          AfterTargets="Restore;_GenerateRestoreGraphProjectEntry"
          Inputs="@(_RaunRidLockInput)"
          Outputs="@(_RaunRidLockOutput)"
          Condition="'$(RaunRidLockRefreshRoot)' == 'true' and '$(RestoreForceEvaluate)' == 'true' and '$(RaunSkipRidLockRefresh)' != 'true'">
    <ItemGroup>
      <_RaunLockRid Include="$(RaunLockedRuntimeIdentifiers)" Exclude="$(NETCoreSdkRuntimeIdentifier)" />
    </ItemGroup>
    <!-- One nested restore per missing RID, over the whole solution: it costs the same as restoring
         the AppHost alone (the Tests project pulls in the same graph) and refreshes both files at
         once, so only the AppHost carries this target. -->
    <Exec Command="dotnet restore &quot;$(RaunSolutionPath)&quot; -p:NETCoreSdkRuntimeIdentifier=%(_RaunLockRid.Identity) -p:RaunSkipRidLockRefresh=true"
          Condition="'@(_RaunLockRid)' != ''"
          StandardOutputImportance="low" />
    <!-- NuGet leaves a lock file's timestamp alone when its content did not change, so without this
         the outputs would stay older than the inputs and the refresh would re-run on every build. -->
    <Touch Files="@(_RaunRidLockOutput)" Condition="Exists('%(_RaunRidLockOutput.Identity)')" />
  </Target>

  <!--
    Packaging metadata and tag-driven versioning, for the shippable libraries only. This file is
    imported AFTER each project file, so IsPackable is known here — Directory.Build.props runs before
    the project body and cannot see it. Tests, samples, and the generator (which ships inside
    Raun.Mtp as an analyzer) set IsPackable=false and are untouched.
  -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/redoz/Raun</PackageProjectUrl>
    <RepositoryUrl>https://github.com/redoz/Raun</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright 2026 Patrik Husfloen</Copyright>

    <!-- Reproducible, source-linked packages. SourceLink for GitHub is built into the SDK; CI adds
         -p:ContinuousIntegrationBuild=true so paths are normalized. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- MinVer: the version is the nearest `v*` tag plus commit height. Nothing to bump by hand, and
         every project in one commit gets the same version, so Raun, Raun.Mtp, and Raun.Aspire
         move in lockstep. An untagged commit after v0.1.0 becomes 0.1.1-preview.0.N; with no tag at
         all, 0.0.0-preview.0.N. Tags are created with git (jj only imports them). -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Tests keep their real source paths. CI builds the whole solution with
       -p:ContinuousIntegrationBuild=true, which maps every compiled path to /_/ for reproducible
       packages; a test never ships, but it does read its own location — [CallerFilePath] is how a
       snapshot test finds its .verified files — and under /_/ it looks in a directory that does not
       exist. Set here, after the Roslyn targets default it, and read only by targets, so it wins. -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <DeterministicSourcePaths>false</DeterministicSourcePaths>
  </PropertyGroup>

</Project>
