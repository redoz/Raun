<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Roslyn variant projects pin their CodeAnalysis version via VersionOverride="x.y.*". -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- xUnit v3 extensibility surface (IXunitTestCase, discoverers, self-executing cases). -->
    <PackageVersion Include="xunit.v3.extensibility.core" Version="3.2.2" />

    <!--
      Microsoft.Testing.Platform v2. The xunit-based test projects opt into the MTP v2 runner by
      referencing `xunit.v3.mtp-v2` (xunit.v3 3.2.0+ selects its MTP major via package choice; the
      default `xunit.v3` package is MTP v1). This replaced the old 1.9.1 pin: the earlier 2.x attempt
      failed only because the test projects stayed on the v1 runner package while MTP unified to 2.x.
      Pinned at 2.4.0, which adds terminal options (progress, ansi, output minimal,
      show-slowest-tests, show-flaky-tests, show-test-results) needing no code change.
    -->
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.4.1" />

    <!-- ILogger bridge: step logs written through the standard .NET logging abstraction.
         Abstractions only — no logging implementation is taken as a dependency. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />

    <!-- DI: Raun.Mtp needs only the abstractions (IServiceScopeFactory); the test project needs
         the implementation to build a provider. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />

    <!-- Aspire integration (Raun.Aspire + the Aspire sample). -->
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.5.4" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.5.4" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />

    <!-- Coverage spike: does the profiler reach Aspire's child processes?
         Moves in lockstep with Microsoft.Testing.Platform above: a version mismatch surfaces as a
         TypeLoadException after tests pass, not a coverage bug. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />

    <!-- TRX reporting, for the AppointmentTests sample only: it is what proves (and documents) that
         a platform extension reaches a Raun run through RunAsync's `configure` callback. Moves in
         lockstep with Microsoft.Testing.Platform above. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.1" />

    <!-- OpenTelemetry, for the Aspire sample only: the test process exports Raun's spans and the API
         exports its own, both over OTLP, so one trace shows a step and the server work it caused.
         Raun itself takes no OpenTelemetry dependency — it emits through System.Diagnostics. -->
    <PackageVersion Include="OpenTelemetry" Version="1.*" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.*" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.*" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.*" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.*" />

    <!--
      Roslyn the primary generator builds against. Installed SDK 10.0.300 ships Roslyn
      5.6.0; 5.3.0 is the latest published Microsoft.CodeAnalysis.CSharp and is <= the
      host compiler, so the generator loads cleanly (a generator can never reference a
      newer Roslyn than the host). Older .NET 10 SDKs that shipped Roslyn 5.0-5.2 can be
      supported later by adding a lower Raun.Generator.Roslyn<NN> variant.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />

    <!-- Tag-driven versioning for the packable libraries (referenced from Directory.Build.targets). -->
    <PackageVersion Include="MinVer" Version="8.0.0" />

    <!-- Test infrastructure. xunit.v3 is pinned to match xunit.v3.extensibility.core. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.1" />
    <!-- Assertions only (Assert.Equal/NotNull/...) for Raun.Mtp consumers: scenario step bodies keep
         `using Xunit;` verbatim. Pinned to match the xunit.v3 line above. -->
    <PackageVersion Include="xunit.v3.assert" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
  </ItemGroup>

</Project>
