<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Roslyn variant projects pin their CodeAnalysis version via VersionOverride="x.y.*". -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- xUnit v3 extensibility surface (IXunitTestCase, discoverers, self-executing cases). -->
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />

    <!--
      Microsoft.Testing.Platform v2. The xunit-based test projects opt into the MTP v2 runner by
      referencing `xunit.v3.mtp-v2` (xunit.v3 3.2.0+ selects its MTP major via package choice; the
      default `xunit.v3` package is MTP v1). This replaced the old 1.9.1 pin: the earlier 2.x attempt
      failed only because the test projects stayed on the v1 runner package while MTP unified to 2.x.
      Version 2.4.0 added terminal options (progress, ansi, output minimal,
      show-slowest-tests, show-flaky-tests, show-test-results) needing no code change.
    -->
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.5.3" />

    <!-- ILogger bridge: step logs written through the standard .NET logging abstraction.
         Abstractions only â€” no logging implementation is taken as a dependency. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.15" />

    <!-- DI: Raun.Mtp needs only the abstractions (IServiceScopeFactory); the test project needs
         the implementation to build a provider. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />

    <!-- Aspire integration (Raun.Aspire + the Aspire sample). -->
    <PackageVersion Include="Aspire.Hosting.Testing" Version="17.0.0" />
    <!-- The sample AppHost: a plain Microsoft.NET.Sdk project since Aspire 17 (Aspire.AppHost.Sdk is
         obsolete, ASPIRE012). All Aspire packages move together. -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.15" />

    <!-- Coverage spike: does the profiler reach Aspire's child processes?
         Moves in lockstep with Microsoft.Testing.Platform above: a version mismatch surfaces as a
         TypeLoadException after tests pass, not a coverage bug. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="coverlet.MTP" Version="10.1.1" />

    <!-- TRX reporting, for the AppointmentTests sample only: it is what proves (and documents) that
         a platform extension reaches a Raun run through RunAsync's `configure` callback. Moves in
         lockstep with Microsoft.Testing.Platform above. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3" />

    <!-- OpenTelemetry, for the Aspire sample only: the test process exports Raun's spans and the API
         exports its own, both over OTLP, so one trace shows a step and the server work it caused.
         Raun itself takes no OpenTelemetry dependency â€” it emits through System.Diagnostics. -->
    <PackageVersion Include="OpenTelemetry" Version="1.*" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.*" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.*" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.*" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.*" />

    <!--
      Roslyn for Raun.Coverage (which ships the Workspaces packages as dependencies) and for the
      generator tests. NOT the generator: Raun.Generator.csproj overrides this with
      $(RaunRoslynVersion), because a compiler older than the Roslyn a generator references
      refuses to load it. A consumer pinning Roslyn packages sees these versions, so they move
      by hand (Dependabot ignores minor and major updates).
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <!-- 18.10.x targets .NET 11; 18.9.6 is the latest .NET 10-compatible MSBuild, which the
         net10.0 build of Raun.Coverage must load against. Newer MSBuild runtimes accept it. -->
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.9.6" />
    <PackageVersion Include="Microsoft.NET.StringTools" Version="18.9.6" />

    <!-- Tag-driven versioning for the packable libraries (referenced from Directory.Build.targets). -->
    <PackageVersion Include="MinVer" Version="8.0.0" />

    <!-- Test infrastructure. xunit.v3 is pinned to match xunit.v3.extensibility.core. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3" />
    <!-- Assertions only (Assert.Equal/NotNull/...) for Raun.Mtp consumers: scenario step bodies keep
         `using Xunit;` verbatim. Pinned to match the xunit.v3 line above. -->
    <PackageVersion Include="xunit.v3.assert" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
  </ItemGroup>

</Project>
