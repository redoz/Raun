<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(RaunTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit project testing Raun.Aspire; it uses the Test SDK's entry point. -->
    <RaunGenerateProgram>false</RaunGenerateProgram>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="RaunGenerateProgram" />
  </ItemGroup>

  <!-- Unit-level coverage only: everything here runs WITHOUT a container runtime. Actually standing
       up an AppHost is the Aspire sample's job, which is the integration test for this package. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Raun.Aspire\Raun.Aspire.csproj" />
  </ItemGroup>

</Project>
