<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RaunGenerateProgram>false</RaunGenerateProgram>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- MSBuildLocator loads MSBuild and StringTools from the installed SDK together. -->
    <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <ProjectReference Include="../../src/Raun.Coverage/Raun.Coverage.csproj" />
  </ItemGroup>
  <ItemGroup><Compile Remove="Fixtures/**/*.cs" /></ItemGroup>
</Project>
