<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- This project IS a Microsoft.Testing.Platform test app whose entry point is generated by
         Raun (the MTP Main forwarding to Raun.Mtp.RaunTestApplication.RunAsync). The repo
         global.json selects the MTP runner for `dotnet test`. -->
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- Raun normally emits the single Main; suppress the SDK-provided entry points so there is no
         clash. (Package consumers get this from Raun.Mtp's buildTransitive targets and the
         RaunGenerateProgram default from Raun's props; the sample references both by project, so
         we set them here directly.) -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    <!-- This showcase hand-writes Program.cs (below) so it can opt into Raun's deterministic
         simulated-time scheduler (simulateTime: true) — the authored step durations give the HTML
         report a realistic, overlapping timeline. Suppress the generated entry point to avoid a
         second Main. A real consumer leaves this at its default (true) and gets the generated one. -->
    <RaunGenerateProgram>false</RaunGenerateProgram>
  </PropertyGroup>

  <!-- Expose the entry-point gate to the generator (default true ⇒ emit RaunProgram.g.cs). -->
  <ItemGroup>
    <CompilerVisibleProperty Include="RaunGenerateProgram" />
  </ItemGroup>

  <!-- The canonical end-to-end sample: authoring scenarios with the Given/When/Then DSL, run by
       Raun's own Microsoft.Testing.Platform test framework with each business step reported as its
       own MTP test node. A real consumer would `dotnet add package Raun.Mtp` (Raun, with the
       generator inside, comes with it) plus `xunit.v3.assert`; here we reference the adapter by
       project and wire the generator in as an analyzer, and bring assertions only. -->
  <ItemGroup>
    <PackageReference Include="xunit.v3.assert" />
    <!-- A platform extension, registered through RunAsync's `configure` below: the `report-trx`
         option then works exactly as it does for any other MTP test app. -->
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <!-- Only for the [LoggerMessage] source generator the lifecycle DSL uses; ILogger itself arrives
         transitively through Raun. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Raun.Mtp\Raun.Mtp.csproj" />
    <ProjectReference Include="..\..\src\Raun.Generator\Raun.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
