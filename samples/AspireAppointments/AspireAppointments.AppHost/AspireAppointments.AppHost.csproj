<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>raun-aspire-appointments</UserSecretsId>
    <NoWarn>$(NoWarn);CA1852;CA2007;ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Retain Aspire compatibility while taking the patched transitive version. -->
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AspireAppointments.Api\AspireAppointments.Api.csproj" />
  </ItemGroup>

</Project>
