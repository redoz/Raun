<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestingPlatformApplication>true</IsTestingPlatformApplication>
    <!-- The point of this sample: the entry point is REAL CODE you can read and breakpoint, not a
         generated file. Program.cs builds the AppHost, declares what to wait for, and registers the
         suite's own services. -->
    <RaunGenerateProgram>false</RaunGenerateProgram>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="RaunGenerateProgram" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="coverlet.MTP" />
    <!-- Exports Raun's spans (and the HttpClient spans under them) over OTLP. Raun itself has no
         OpenTelemetry dependency; the suite decides where its traces go. -->
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Raun.Aspire\Raun.Aspire.csproj" />
    <ProjectReference Include="../../../src/Raun.Coverage/Raun.Coverage.csproj" PrivateAssets="none" />
    <ProjectReference Include="..\..\..\src\Raun.Generator\Raun.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- Gives DistributedApplicationTestingBuilder the generated Projects.* type for the AppHost. -->
    <ProjectReference Include="..\AspireAppointments.AppHost\AspireAppointments.AppHost.csproj"
                      IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
