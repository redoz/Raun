<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <Description>Source-first classified branch coverage analysis for Raun reports.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- MSBuildLocator loads MSBuild and StringTools from the installed SDK together. -->
    <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all" />
    <ProjectReference Include="../Raun/Raun.csproj" PrivateAssets="none" />
    <ProjectReference Include="../Raun.Mtp/Raun.Mtp.csproj" PrivateAssets="none" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" GeneratePathProperty="true" ExcludeAssets="contentFiles" />
    <PackageReference Include="Microsoft.Build.Locator" PrivateAssets="build;buildTransitive;analyzers" />
    <InternalsVisibleTo Include="Raun.Coverage.Test" />
  </ItemGroup>
  <ItemGroup>
    <None Include="buildTransitive/Raun.Coverage.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>
  <Import Project="buildTransitive/Raun.Coverage.targets" />
</Project>

