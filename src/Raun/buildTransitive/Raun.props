<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <!--
      The Raun source generator emits the Microsoft.Testing.Platform entry point (a Main calling
      Raun.Mtp's RunAsync) when the project references Raun.Mtp. Default it on; a consumer sets
      <RaunGenerateProgram>false</RaunGenerateProgram> to supply their own Program.cs and call the
      public bootstrap directly.
    -->
    <RaunGenerateProgram Condition="'$(RaunGenerateProgram)' == ''">true</RaunGenerateProgram>
  </PropertyGroup>

  <!-- Surface the property to the source generator (read as build_property.RaunGenerateProgram). -->
  <ItemGroup>
    <CompilerVisibleProperty Include="RaunGenerateProgram" />
  </ItemGroup>

</Project>
