<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- This is the FRAMEWORK library, not a runnable test app. The Microsoft.Testing.Platform
         package defaults IsTestingPlatformApplication to true, which would make `dotnet test` (under
         the repo's MTP runner in global.json) try to run this library as a test executable and fail
         with "OutputType is 'Library'". Consumers (the sample, generated entry points) are the
         runnable apps; opt this library out. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <Description>
      Microsoft.Testing.Platform adapter for Raun: Raun's own ITestFramework that discovers,
      runs, and reports each scenario step as a first-class MTP test node, plus the public
      bootstrap (RunAsync) the generated entry point calls. The runtime and the source
      generator come from the Raun package this one depends on.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets="none": pack would otherwise write this dependency with
         exclude="Build,Analyzers", and a consumer of Raun.Mtp would get neither Raun's generator
         nor its props. -->
    <ProjectReference Include="..\Raun\Raun.csproj" PrivateAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Raun.Mtp.Test" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Platform" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <!--
    When Raun's generator emits the entry point, the SDK's own entry points must be suppressed so
    there is exactly one Main. That is an MTP-application concern, so the targets ship here; the
    props that default RaunGenerateProgram ship with the generator, in the Raun package.
    buildTransitive flows both through project-to-project references too.
  -->
  <ItemGroup>
    <None Include="buildTransitive\Raun.Mtp.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

</Project>
